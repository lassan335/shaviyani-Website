generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  team         String
  collection   String
  league       String?
  mode         String // "instant" | "preorder"
  price        Int // MVR, integer minor-unit-free (whole rufiyaa)
  preorderEta  String?
  description  String?
  gradientFrom String
  gradientTo   String
  image        String? // path under /public, e.g. "/Products/Feleyla.jpg"
  materials    String // comma-separated list
  sizes        String // comma-separated list
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  orderItems   OrderItem[]
}

model Order {
  id            String           @id @default(cuid())
  orderNumber   String           @unique
  customerName  String
  customerEmail String
  customerPhone String?
  address       String
  island        String?
  subtotal      Int
  shippingCost  Int              @default(0)
  supplierCost  Int              @default(0)
  status        String           @default("Placed")
  isPreorder    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  items         OrderItem[]
  statusLogs    OrderStatusLog[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  material  String
  size      String
  qty       Int
  price     Int
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  changedAt DateTime @default(now())
}

model QuoteRequest {
  id          String      @id @default(cuid())
  teamName    String
  contactName String
  email       String
  phone       String?
  notes       String?
  status      String      @default("New")
  createdAt   DateTime    @default(now())
  items       QuoteItem[]
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id])
  style          String
  material       String
  size           String
  qty            Int
}

// Singleton row (id always "zoho") holding the Zoho Books OAuth tokens for
// the jersey quote generator in /admin/quote-generator.
model ZohoToken {
  id           String   @id @default("zoho")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

// Admin accounts for /admin. Until at least one row exists, adminLogin()
// falls back to the ADMIN_PASSWORD env var (username "admin") so a fresh
// deploy can still log in and create its first real user from /admin/settings.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
}

// Storefront collections (was a hardcoded array in lib/collections.js),
// now editable from /admin/collections. Product.collection stores the
// collection's *name* (a loose string reference, not a foreign key) to
// match how products already reference collections.
model Collection {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  blurb        String?
  gradientFrom String
  gradientTo   String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

// Singleton row (id always "home") holding the homepage hero + campaign
// section copy, editable from /admin/content instead of hardcoded JSX.
model SiteContent {
  id                  String   @id @default("home")
  heroKicker          String
  heroTitleLine1      String
  heroTitleAccent     String
  heroBody            String
  heroTrustLine       String
  heroImage           String?
  campaignKicker      String
  campaignTitleLine1  String
  campaignTitleAccent String
  campaignBody        String
  campaignImage        String?
  updatedAt           DateTime @updatedAt
}
